{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Latiao",
  "version": "0.3.1",
  "identifier": "com.latiao.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "\u8fa3\u6761 Latiao",
        "width": 1200,
        "height": 800,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8765 https://huggingface.co https://api.deepseek.com https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com; img-src 'self' data: blob:; media-src 'self' data: blob: mediastream:; font-src 'self' data:; worker-src 'self' blob: https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../sidecar": "sidecar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "allow": [
        {
          "name": "sidecar/*"
        }
      ]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/RenYiX0620/Latiao/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "ZFc1MGNuVnpkR1ZrSUdOdmJXMWxiblE2SUcxcGJtbHphV2R1SUhCMVlteHBZeUJyWlhrNklEWTBSa0pEUWpCRFJUUTFRalEwTjBFS1VsZFNObEpHZG10RVRYWTNXazlNVW5WTlJYVmlMMXB5YUVJNFRGZEJXREZEV1VwM1ZUaFpUVVF2Y0RkUVN6bFdUalEyU1hReFdHc0s=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}